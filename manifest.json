{
  "manifest_version": 3,
  "name": "Ответы@Майл.ру+",
  "version": "1.0.3",

  "description": "Дополнительные возможности для приятного деградирования на лучшем в мире сайте.",
  "icons": {
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "background": {
    "scripts": ["libs/browser-polyfill.js", "libs/fstore.js", "back.js"],
    "service_worker": "back-sw.js"
  },
  "action": {
    "default_title": "OMR Plus",
    "default_icon": {
      "32": "icon/32.png"
    },
    "default_popup": "addon-ui/popup.html"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*.mail.ru/*",
    "https://*.mail.ru/*"
  ],
  "content_scripts": [{
    "js": [
      "libs/browser-polyfill.js", "libs/freiweb.js", "libs/frouter.js", "libs/fstore.js",
      "css.cns.js", "ans.cns.js",

      "libs/emoji/emoji-ru.js", "libs/emoji/emoji-data.js", "libs/emoji/emoji-mart.js", "libs/emoji/emoji-popup.js",
      "api/api.cns.js",
      "ui-conscripts/ui-bulk.cns.js", "ui-conscripts/ui-emojis.cns.js",
      "ui-conscripts/ui-quick-ask.cns.js",
      "ui-conscripts/ui-profile.cns.js", "ui-conscripts/ui-posts.cns.js",

      "net-filter.cns.js"
    ],
    "matches": [ "*://otvet.mail.ru/*" ],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "matches": [ "*://otvet.mail.ru/*" ],
    "resources": [ "libs/emoji/emoji-ru.js", "libs/emoji/emoji-data.js", "libs/emoji/emoji-mart.js", "libs/emoji/emoji-popup.js",
      "net-filter.inject.js", "ui-conscripts/ui-emojis.inject.js",
      "api/payment-modal.inject.js"
    ]
  }]
}
